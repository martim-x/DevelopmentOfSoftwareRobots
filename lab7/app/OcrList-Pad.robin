# OcrList-Pad: распознавание списка студентов с изображения Student.jpg и перенос в Excel.
# Лабораторная работа 7. Power Automate Desktop (robin).

OCR.ExtractTextWithOCR.ExtractTextFromFileWithWindowsOcr ImageFile: $'''C:\\Users\\timof\\Documents\\Visual Studio Code\\DevelopmentOfSoftwareRobots\\lab7\\app\\Data\\Input\\Student.jpg''' ImageWidthMultiplier: 1 ImageHeightMultiplier: 1 WindowsOcrLanguage: OCR.WindowsOcrLanguage.Russian OcrText=> OcrText

Text.SplitText.Split Text: OcrText StandardDelimiter: Text.StandardDelimiter.NewLine DelimiterTimes: 1 Result=> TextList

Excel.LaunchExcel.Launch UseMachineLocale: False Visible: True LoadAddInsAndMacros: False Instance=> ExcelInstance

SET NewVar TO 1

FOREACH CurrentItem IN TextList
    Excel.WriteToExcel.WriteCell Instance: ExcelInstance Value: CurrentItem Column: $'''A''' Row: NewVar
    Variables.IncreaseVariable Value: NewVar IncrementValue: 1
END

Excel.CloseExcel.Close Instance: ExcelInstance
